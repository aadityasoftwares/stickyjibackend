{
    "name": "stickyji-backend",
    "version": "1.0.0",
    "description": "Sticky Ji - Productivity and Sticky Notes SaaS Backend",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --exec tsx src/server.ts",
        "build": "tsc",
        "test": "node --import tsx --test --test-concurrency=4 tests/*.test.mjs",
        "test:subscriptions": "node --import tsx --test tests/usersubscription.test.mjs tests/subscriptionUsage.test.mjs tests/subscriptionSeed.test.mjs tests/subscriptionEntitlement.test.mjs",
        "test:usersubscription": "node --import tsx --test tests/usersubscription.test.mjs",
        "test:subscription-usage": "node --import tsx --test tests/subscriptionUsage.test.mjs",
        "test:subscription-seed": "node --import tsx --test tests/subscriptionSeed.test.mjs",
        "test:subscription-entitlement": "node --import tsx --test tests/subscriptionEntitlement.test.mjs",
        "test:billing": "node --import tsx --test tests/billing.test.mjs",
        "seed:subscriptions": "tsx src/scripts/seed-default-subscriptions.ts",
        "seed:subscriptions:apply": "tsx src/scripts/seed-default-subscriptions.ts --apply",
        "seed:subscriptions:verify": "tsx src/scripts/seed-default-subscriptions.ts --verify",
        "seed:subscriptions:dry-run": "tsx src/scripts/seed-default-subscriptions.ts --dry-run",
        "db:init": "tsx src/scripts/initialize-database.ts",
        "db:init:verify": "tsx src/scripts/verify-database-initialization.ts",
        "test:db-init": "node --import tsx --test tests/databaseInitialization.test.mjs",
        "test:registration-free": "node --import tsx --test tests/registrationFreeSubscription.test.mjs",
        "backfill:ranks": "tsx src/scripts/backfillRanks.ts",
        "backfill:sticky-numbers": "tsx src/scripts/backfillStickyNoteNumbers.ts",
        "backfill:pending-users": "tsx src/scripts/backfill-pending-users.ts --dry-run",
        "backfill:pending-users:apply": "tsx src/scripts/backfill-pending-users.ts --apply",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:auth": "prettier --write \"src/modules/auth/**/*.{ts,tsx}\" \"src/middlewares/authmiddleware/**/*.{ts,tsx}\"",
        "format:auth:check": "prettier --check \"src/modules/auth/**/*.{ts,tsx}\" \"src/middlewares/authmiddleware/**/*.{ts,tsx}\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1098.0",
        "@aws-sdk/s3-request-presigner": "^3.1098.0",
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.8.1",
        "multer": "^2.2.0",
        "node-cron": "^4.6.0",
        "nodemailer": "^9.0.3",
        "resend": "^6.20.0",
        "sharp": "^0.35.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.2",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.1",
        "nodemon": "^3.1.14",
        "prettier": "3.9.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
